# Generated by ansible/playbooks/ssh-config.yml — do not edit by hand.
# Regenerate with: make ssh-config
# Usage:           ssh -F .ssh-config <host>
{% set bastion = groups['bastion'][0] %}

# --- Bastion: reached directly over the data diode (host-only network) ------
Host {{ bastion }}
  HostName {{ hostvars[bastion].transfer_ip }}
  User {{ hostvars[bastion].ansible_user }}
  IdentityFile {{ repo_root }}/.vagrant/machines/{{ bastion }}/virtualbox/private_key
  IdentitiesOnly yes
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  LogLevel ERROR

# --- Cluster nodes: reachable only through the bastion ----------------------
{% for host in groups['k8s_cluster'] %}
Host {{ host }}
  HostName {{ hostvars[host].airgap_ip }}
  User {{ hostvars[host].ansible_user }}
  ProxyJump {{ bastion }}
  IdentityFile {{ repo_root }}/.vagrant/machines/{{ host }}/virtualbox/private_key
  IdentitiesOnly yes
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  LogLevel ERROR

{% endfor %}
